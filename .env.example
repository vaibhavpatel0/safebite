# SafeByte configuration
#
# Copy this file to .env and fill in your own keys:
#     cp .env.example .env
#
# .env is listed in .gitignore and must never be committed.
# If a key is left blank that provider is simply skipped; the chain falls
# through to the next one.

# --- AI providers -----------------------------------------------------------
# Groq        https://console.groq.com          (chat only: no vision model)
GROQ_API_KEY=

# Gemini      https://aistudio.google.com/apikey  (scans and chat)
GEMINI_API_KEY=

# Mistral     https://console.mistral.ai          (scans and chat)
MISTRAL_API_KEY=

# OpenRouter  https://openrouter.ai/keys          (scans and chat, last resort)
OPENROUTER_API_KEY=

# --- FSSAI licence lookup ---------------------------------------------------
VERIFICO_API_KEY=

# --- Optional -------------------------------------------------------------
# Override the model names if a provider retires one. Run `node check-vision.js`
# to find out which models your keys can actually use.
# GROQ_MODEL_CHAT=
# GEMINI_MODEL=
# MISTRAL_MODEL_VISION=
# MISTRAL_MODEL_CHAT=
# OPENROUTER_MODEL=

# Port the server listens on (default 3000)
# PORT=3000
